{
  "appId": "com.studentproject.mdunavigator",
  "appName": "MDU Navigator",
  "webDir": "www",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  },
  "android": {
    "backgroundColor": "#1d5fa8"
  },
  "ios": {
    "backgroundColor": "#1d5fa8",
    "contentInset": "never"
  }
}